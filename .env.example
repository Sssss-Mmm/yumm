# 환경변수 템플릿. 값은 비워 둔다 — 실제 값은 .env(커밋 금지)나 배포 환경 설정에만 넣는다.
# 앱이 이 파일을 읽지는 않는다. 셸에서 환경변수로 올려야 한다:
#   cp .env.example .env && vi .env && set -a; source .env; set +a

# 필수. 없으면 서버가 기동하지 않는다. openssl rand -base64 32
JWT_SECRET=

# DB / Redis. 비우면 로컬 기본값(application.properties)을 쓴다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# 알림 메일(FR-N-01). SMTP_HOST가 비면 메일을 보내지 않는다(로컬 기본).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# 보내는 사람 주소. 중계 서버 대부분이 인증 계정과 다른 From을 거부한다.
SMTP_FROM=
